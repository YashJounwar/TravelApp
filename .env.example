NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# JSON stringified service account credentials for server-side Admin SDK
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin dashboard controls
ADMIN_DASHBOARD_ENABLED=true
ALLOW_DEV_ADMIN_BYPASS=true
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Development only fallback; use ADMIN_PASSWORD_HASH in production
ADMIN_PASSWORD=

# Server-only AI support chatbot settings
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.1

# Public canonical site URL used for SEO metadata, sitemap, robots.txt, and llms.txt
NEXT_PUBLIC_SITE_URL=https://shanvitravels.in
